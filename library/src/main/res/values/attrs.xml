<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="ListView">
        <attr name="parchment_orientation" format="enum">
            <enum name="horizontal" value="0"/>
            <enum name="vertical" value="1"/>
        </attr>
        <attr name="parchment_cellSpacing" format="dimension"/>
        <attr name="parchment_isCircularScroll" format="boolean"/>
        <attr name="parchment_snapToPosition" format="boolean"/>
        <attr name="parchment_selectOnSnap" format="boolean"/>
        <attr name="parchment_isViewPager" format="boolean"/>
        <attr name="parchment_viewPagerInterval" format="integer">
            <enum name="viewport" value="0"/>
        </attr>
        <attr name="parchment_snapPosition" format="enum">
            <enum name="center" value="0"/>
            <enum name="start" value="1"/>
            <enum name="end" value="2"/>
            <enum name="onScreen" value="3"/>
        </attr>
        <attr name="parchment_selectWhileScrolling" format="boolean"/>
    </declare-styleable>

    <declare-styleable name="GridView">
        <attr name="parchment_numberOfViewsPerCell" format="integer"/>
        <attr name="parchment_gravity">
            <flag name="left" value="0x02"/>
            <flag name="right" value="0x04"/>
            <flag name="top" value="0x08"/>
            <flag name="bottom" value="0x10"/>
        </attr>
    </declare-styleable>

    <declare-styleable name="GridPatternView">
        <attr name="parchment_ratio" format="float"/>
    </declare-styleable>


</resources>