<resources>

    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/ActionBar</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ActionBar.TitleTextStyle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/action_bar_text_color</item>
    </style>

    <style name="ActionBar" parent="@android:style/Widget.Material.Light.ActionBar">
        <item name="android:background">@color/action_bar_background</item>
        <item name="android:titleTextStyle">@style/ActionBar.TitleTextStyle</item>
    </style>

    <style name="ButtonStyle" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_selector</item>
        <item name="android:paddingStart">@dimen/button_padding</item>
        <item name="android:paddingEnd">@dimen/button_padding</item>
        <item name="android:layout_marginTop">@dimen/button_margin</item>
        <item name="android:layout_marginBottom">@dimen/button_margin</item>
    </style>

    <style name="Heading" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/action_bar_text_color</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginTop">@dimen/section_spacing</item>
    </style>

    <style name="Label" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/action_bar_text_color</item>
        <item name="android:layout_marginTop">@dimen/status_padding</item>
    </style>

    <style name="Hint" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/action_bar_text_color</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Choices">
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Status" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/action_bar_text_color</item>
        <item name="android:background">@color/action_bar_background</item>
        <item name="android:padding">@dimen/status_padding</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Xml">
        <item name="android:textColor">@color/action_bar_text_color</item>
        <item name="android:textSize">@dimen/xml_text_size</item>
        <item name="android:typeface">monospace</item>
        <item name="android:padding">@dimen/dialog_padding</item>
    </style>

    <style name="FloatingActionButton">
        <item name="android:background">@drawable/floating_action_button_background</item>
        <item name="android:elevation">@dimen/floating_action_button_elevation</item>
        <item name="android:tint">@android:color/white</item>
        <item name="android:layout_margin">@dimen/floating_action_button_margin</item>
    </style>

</resources>
